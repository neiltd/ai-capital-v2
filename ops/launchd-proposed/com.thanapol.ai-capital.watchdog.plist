<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.thanapol.ai-capital.watchdog</string>

  <!-- Separate agent, separate process, no shared code path with the pipeline.
       The previous detector for "today's run is missing" lived inside
       daily-catchup.sh — the job that has to run in order to notice. On
       2026-08-27 nothing ran and nothing was reported. -->
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/thanapold/Desktop/Projects.nosync/scripts/pipeline-watchdog.sh</string>
  </array>

  <key>StandardOutPath</key><string>/Users/thanapold/Desktop/Projects.nosync/logs/pipeline-watchdog.log</string>
  <key>StandardErrorPath</key><string>/Users/thanapold/Desktop/Projects.nosync/logs/pipeline-watchdog.log</string>
</dict>
</plist>
