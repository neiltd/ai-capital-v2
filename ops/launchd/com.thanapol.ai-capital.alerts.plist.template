<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — NOT AN INSTALLED AGENT. Supersedes the tracked daily-alerts.plist.

  LaunchAgent for the hot-ticker alerter (scenario-simulator's cli-alerts.ts).
  Runs every 30 min across three market windows (PT local): US 9:30-4pm ET,
  Thai SET morning, Thai SET afternoon. Uses launchd (not cron) so it inherits
  the logged-in user's TCC grants instead of hitting "Operation not permitted"
  on files under ~/Desktop.

  CREDENTIAL CONTRACT. scripts/run-alerts.sh no longer carries a default
  connection string; it execs packages/queue/bin/run-stage.ts, which reads the
  file named by PIPELINE_CREDENTIAL_FILE, validates the URL and the exact
  ai_capital_pipeline role, strips every other database credential from the child
  environment, and derives DATABASE_URL from the validated value. The alerter is
  a pipeline consumer like any stage, and holds no inline credential.

  RENDERING (the renderer now exists, and it handles no secret).
  This file is a SOURCE ARTIFACT. It is rendered by
  packages/queue/bin/render-launchd-plist.ts, which substitutes only a
  repository path, an unauthenticated Redis endpoint, and the PATH of the
  credential file. It refuses any template carrying a credential-value
  placeholder, and it parses its own output to confirm no EnvironmentVariables
  entry holds a PostgreSQL URL — mixed-case and XML-entity forms included.

  The earlier `sed` instructions were removed rather than fixed: passing a value
  through command arguments exposes it in the process table, and `sed`
  mishandles `&`, `|`, backslashes and `& < >`. The renderer escapes XML, writes
  through a private same-directory temporary, fsyncs, lints, publishes with
  link(2) so a competing writer is never destroyed, and fsyncs the directory.

    pnpm --filter @common/queue render-plist -- --agent <name> --root <abs> …

  The credential file itself is written by
  packages/queue/bin/install-pipeline-credential.ts, which reads the secret only
  from a no-echo terminal or a pre-opened descriptor — never argv or stdout.

  NOTHING HAS BEEN PROVISIONED OR INSTALLED. No credential exists, no plist is
  installed, and no agent has been started or restarted. If Time Machine
  exclusion of the credential directory is approved, it must be applied and
  verified BEFORE the credential file is first created — deleting a file does
  not remove it from existing backup history.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.thanapol.ai-capital.alerts</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@@AI_CAPITAL_ROOT@@/scripts/run-alerts.sh</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PIPELINE_RUNS_DB</key>
		<string>@@AI_CAPITAL_ROOT@@/data/pipeline-runs.db</string>
		<key>DATA_ROOT</key>
		<string>@@AI_CAPITAL_ROOT@@/apps</string>
		<key>PIPELINE_CREDENTIAL_FILE</key>
		<string>@@PIPELINE_CREDENTIAL_FILE@@</string>
	</dict>

	<key>StartCalendarInterval</key>
	<array>
		<!-- US session 9:30am-4pm ET = 6:00-13:00 PT, Mon-Fri -->
		<dict>
			<key>Weekday</key>
			<array><integer>1</integer><integer>2</integer><integer>3</integer><integer>4</integer><integer>5</integer></array>
			<key>Hour</key>
			<array><integer>6</integer><integer>7</integer><integer>8</integer><integer>9</integer><integer>10</integer><integer>11</integer><integer>12</integer><integer>13</integer></array>
			<key>Minute</key>
			<array><integer>0</integer><integer>30</integer></array>
		</dict>
		<!-- Thai SET morning 10:00-12:30 ICT = 19:00-22:30 PT prior evening, Sun-Thu -->
		<dict>
			<key>Weekday</key>
			<array><integer>0</integer><integer>1</integer><integer>2</integer><integer>3</integer><integer>4</integer></array>
			<key>Hour</key>
			<array><integer>19</integer><integer>20</integer><integer>21</integer><integer>22</integer></array>
			<key>Minute</key>
			<array><integer>0</integer><integer>30</integer></array>
		</dict>
		<!-- Thai SET afternoon 14:30-16:30 ICT = 0:30-3:30 PT same night, Mon-Fri -->
		<dict>
			<key>Weekday</key>
			<array><integer>1</integer><integer>2</integer><integer>3</integer><integer>4</integer><integer>5</integer></array>
			<key>Hour</key>
			<array><integer>0</integer><integer>1</integer><integer>2</integer><integer>3</integer></array>
			<key>Minute</key>
			<array><integer>0</integer><integer>30</integer></array>
		</dict>
	</array>

	<key>StandardOutPath</key>
	<string>@@AI_CAPITAL_ROOT@@/logs/alerts.log</string>
	<key>StandardErrorPath</key>
	<string>@@AI_CAPITAL_ROOT@@/logs/alerts.log</string>
</dict>
</plist>
