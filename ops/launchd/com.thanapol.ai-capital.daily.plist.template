<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — NOT AN INSTALLED AGENT. Supersedes
  ops/launchd-proposed/com.thanapol.ai-capital.daily.plist.

  Opportunity-based daily scheduler. launchd supplies frequent execution
  opportunities; the script decides eligibility from recorded state.

  RunAtLoad SEMANTICS. RunAtLoad=true makes launchd execute the SCRIPT
  immediately on load. It does NOT mean a pipeline is submitted:
  daily-scheduler.sh decides eligibility from recorded state every time, and an
  ineligible opportunity exits 0 having submitted nothing.

  NO DATABASE CREDENTIAL, DELIBERATELY. The superseded file carried one. The
  scheduler only submits to Redis and reads the SQLite run ledger
  (packages/pipeline-runs); every stage that touches PostgreSQL executes inside
  the queue worker, which holds the credential. Adding one here would widen the
  blast radius without enabling anything.

  Loading the installed copy is a PRODUCTION-STATE ACTION and requires separate
  authorization.

  INSTALLATION IS BLOCKED UNTIL A CREDENTIAL-SAFE RENDERER EXISTS.
  This file is a SOURCE ARTIFACT ONLY. It is not installable as written, and the
  earlier `sed`-based instructions were removed rather than fixed: passing a
  credential through command arguments exposes it in the process table, and
  `sed` mishandles `&`, `|`, backslashes and the XML-sensitive characters
  `& < >`, which can silently alter or corrupt the value it substitutes.

  A separately reviewed renderer must exist first. Its contract:
    * XML-escape every substituted value;
    * keep credentials out of argv and out of stdout;
    * write through a private temporary file created with mode 0600;
    * run `plutil -lint` on the result;
    * publish atomically into ~/Library/LaunchAgents/.
  That renderer is deliberately NOT part of this slice.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.thanapol.ai-capital.daily</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@@AI_CAPITAL_ROOT@@/scripts/daily-scheduler.sh</string>
	</array>

	<!-- Pinned so the script's REPO/ROOT derivation and module resolution do not
	     depend on launchd's inherited working directory. -->
	<key>WorkingDirectory</key>
	<string>@@AI_CAPITAL_ROOT@@</string>

	<!-- launchd supplies a minimal environment. Everything the script and its
	     node/tsx subprocesses need is pinned here. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>AI_CAPITAL_ROOT</key>
		<string>@@AI_CAPITAL_ROOT@@</string>
		<key>PIPELINE_RUNS_DB</key>
		<string>@@AI_CAPITAL_ROOT@@/data/pipeline-runs.db</string>
		<key>SCHEDULER_HEARTBEAT_FILE</key>
		<string>@@AI_CAPITAL_ROOT@@/data/scheduler-heartbeat.log</string>
		<key>DATA_ROOT</key>
		<string>@@AI_CAPITAL_ROOT@@/apps</string>
		<key>REDIS_URL</key>
		<string>@@REDIS_URL@@</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>900</integer>

	<key>StandardOutPath</key>
	<string>@@AI_CAPITAL_ROOT@@/logs/daily-scheduler.log</string>
	<key>StandardErrorPath</key>
	<string>@@AI_CAPITAL_ROOT@@/logs/daily-scheduler.log</string>
</dict>
</plist>
