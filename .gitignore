# Build/install outputs
node_modules/
dist/
.next/
.turbo/

# Secrets / env
.env
.env.local
**/.env
**/.env.local

# macOS noise
.DS_Store
**/.DS_Store

# Runtime DB files (per-project; never commit)
agentdb.rvf
agentdb.rvf.lock
**/agentdb.rvf
**/agentdb.rvf.lock
ruvector.db
**/ruvector.db
data/pipeline-runs.db
data/pipeline-runs.db-shm
data/pipeline-runs.db-wal

# Scrape cache (transient tooling output, not project content)
.firecrawl/

# Stale npm lockfiles — root pnpm-lock.yaml is now the source of truth
apps/*/package-lock.json

# Build artefacts not covered by per-app gitignores
apps/*/.next/
apps/*/tsconfig.tsbuildinfo

# Logs
logs/
**/logs/

# Crontab backups (don't accidentally commit secrets-in-cron)
logs/crontab.*.txt
crontab.*.txt

# IDE noise
.idea/
.vscode/*
!.vscode/extensions.json

# Editor/tooling local state
.superpowers/

# apps/capital-intelligence-ingestion is a SUBMODULE (see .gitmodules), not
# ignored content. Both rules that used to exclude it are gone: the bare
# `capital-intelligence-ingestion/` matched at any depth, so removing only the
# `apps/`-prefixed one would have left the gitlink ignored. Its own repository
# still ignores the local/personal runtime data (data/, .env, caches).

# Old project backups (large, not meant for version control)
_archive/
.git.pre-fresh-start-backup-*/

# claude-flow daemon runtime state (not project content)
.claude-flow/
**/.claude-flow/

# Real portfolio value/holdings reports (personal financial data — never commit)
apps/investment-analyst-agents/tax/harvest.json
apps/investment-analyst-agents/tax/report.md
apps/investment-analyst-agents/risk/risk.json
apps/investment-analyst-agents/risk/report.md
apps/investment-analyst-agents/correlation/report.md

# Scheduler/watchdog runtime state (2026-08-27). NEVER commit these:
# a checked-in empty pipeline-runs.db is a DECOY an ad-hoc run can bind to —
# the exact stale-store hazard CLAUDE.md documents — and a checked-in
# .scheduler-last-state carried a FAKE 'success' written by the test harness
# from a throwaway database.
data/.scheduler-last-state
data/.watchdog-last-state
data/.watchdog-alerted-*
data/scheduler-heartbeat.log
packages/pipeline-runs/data/
